uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 canvas_size;
uniform float3 rot_rad;
uniform float3 pos_offset;
uniform float3 pivot;
uniform float fov_deg;
uniform float shade;
uniform float alpha;
uniform float progress;
uniform float time_sec;

sampler_state tex_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

struct FragData {
	float4 pos      : POSITION;
	float2 uv       : TEXCOORD0;
	float2 stage_uv : TEXCOORD1;
	float  turn     : TEXCOORD2;
	float  peak     : TEXCOORD3;
	float  is_cube  : TEXCOORD4;
};

float Hash11(float p)
{
	p = frac(p * 0.1031);
	p *= p + 33.33;
	p *= p + p;
	return frac(p);
}

float ComputePeak(float3 r, float3 pos_off)
{
	float ang_norm = saturate((abs(r.y) + abs(r.x)) / 1.5707963);
	return max(sin(ang_norm * 3.14159265), saturate(abs(pos_off.z) * 0.45));
}

float4 ProjectStagePoint(float3 p, float aspect, float is_cube)
{
	float half_fov = radians(clamp(fov_deg, 10.0, 120.0)) * 0.5;
	float cam_dist = 1.0 / tan(half_fov);

	float min_clear = abs(pivot.z) * 2.0 + 0.35;
	float eff_cam   = (is_cube > 0.5) ? max(cam_dist, min_clear) : cam_dist;
	float depth_w   = max(eff_cam - p.z, 0.05);

	float ndc_x = (p.x * eff_cam) / (aspect * depth_w);
	float ndc_y = (p.y * eff_cam) / depth_w;

	float2 screen_xy = float2(
		(ndc_x * 0.5 + 0.5) * canvas_size.x,
		(0.5 - ndc_y * 0.5) * canvas_size.y
	);

	float4 clip     = mul(float4(screen_xy, 0.0, 1.0), ViewProj);
	float2 ndc_clip = clip.xy / clip.w;
	return float4(ndc_clip * depth_w, 0.5 * depth_w, depth_w);
}

float3 RotatePoint3D(float3 p, float3 r)
{
	float cx = cos(r.x), sx = sin(r.x);
	float cy = cos(r.y), sy = sin(r.y);
	float cz = cos(r.z), sz = sin(r.z);

	p = float3(p.x, p.y * cx - p.z * sx, p.y * sx + p.z * cx);
	p = float3(p.x * cy + p.z * sy, p.y, -p.x * sy + p.z * cy);
	p = float3(p.x * cz - p.y * sz, p.x * sz + p.y * cz, p.z);
	return p;
}

// ---------------- SHARED VERTEX SHADERS ----------------
FragData VS_Ceiling(VertData v_in)
{
	FragData v_out;
	float is_cube = (abs(pivot.z) > 0.1 && abs(rot_rad.x) < 0.15) ? 1.0 : 0.0;
	float turn    = saturate(abs(rot_rad.y) * 2.2);

	if (is_cube < 0.5 || turn < 0.002) {
		v_out.pos = float4(0.0, 0.0, -2.0, 1.0);
		v_out.uv = v_in.uv; v_out.stage_uv = v_in.pos.xy;
		v_out.turn = 0.0; v_out.peak = 0.0; v_out.is_cube = 0.0;
		return v_out;
	}

	float aspect     = canvas_size.x / max(canvas_size.y, 1.0);
	float3 stage_piv = float3(pivot.x, pivot.y, -pivot.z);
	float depth      = aspect * 0.92;
	float3 p         = float3((v_in.pos.x * 2.0 - 1.0) * aspect, 1.03, (1.0 - v_in.pos.y) * depth);

	p -= stage_piv;
	p  = RotatePoint3D(p, rot_rad);
	p += stage_piv + float3(pos_offset.x, pos_offset.y, pos_offset.z * 0.35);

	v_out.pos      = ProjectStagePoint(p, aspect, is_cube);
	v_out.uv       = v_in.uv;
	v_out.stage_uv = v_in.pos.xy;
	v_out.turn     = turn;
	v_out.peak     = ComputePeak(rot_rad, pos_offset);
	v_out.is_cube  = is_cube;
	return v_out;
}

FragData VS_Floor(VertData v_in)
{
	FragData v_out;
	float is_cube = (abs(pivot.z) > 0.1 && abs(rot_rad.x) < 0.15) ? 1.0 : 0.0;
	float turn    = saturate(abs(rot_rad.y) * 2.2);

	if (is_cube < 0.5 || turn < 0.002) {
		v_out.pos = float4(0.0, 0.0, -2.0, 1.0);
		v_out.uv = v_in.uv; v_out.stage_uv = v_in.pos.xy;
		v_out.turn = 0.0; v_out.peak = 0.0; v_out.is_cube = 0.0;
		return v_out;
	}

	float aspect     = canvas_size.x / max(canvas_size.y, 1.0);
	float3 stage_piv = float3(pivot.x, pivot.y, -pivot.z);
	float depth      = aspect * 0.92;
	float3 p         = float3((v_in.pos.x * 2.0 - 1.0) * aspect, -1.03, (1.0 - v_in.pos.y) * depth);

	p -= stage_piv;
	p  = RotatePoint3D(p, rot_rad);
	p += stage_piv + float3(pos_offset.x, pos_offset.y, pos_offset.z * 0.35);

	v_out.pos      = ProjectStagePoint(p, aspect, is_cube);
	v_out.uv       = float2(v_in.uv.x, 1.0 - (1.0 - v_in.pos.y) * 0.58);
	v_out.stage_uv = v_in.pos.xy;
	v_out.turn     = turn;
	v_out.peak     = ComputePeak(rot_rad, pos_offset);
	v_out.is_cube  = is_cube;
	return v_out;
}

FragData VS_Wall(VertData v_in)
{
	FragData v_out;
	float aspect  = canvas_size.x / max(canvas_size.y, 1.0);
	float is_cube = (abs(pivot.z) > 0.1) ? 1.0 : 0.0;
	float turn    = saturate(length(rot_rad) * 2.2 + abs(pos_offset.z) * 0.35);

	float3 p = float3((v_in.pos.x * 2.0 - 1.0) * aspect, 1.0 - v_in.pos.y * 2.0, 0.0);
	float3 eff_pivot = (is_cube > 0.5) ? float3(pivot.x, pivot.y, -pivot.z) : pivot;
	float3 eff_pos   = (is_cube > 0.5) ? float3(pos_offset.x, pos_offset.y, pos_offset.z * 0.35) : pos_offset;

	p -= eff_pivot;
	p  = RotatePoint3D(p, rot_rad);
	p += eff_pivot + eff_pos;

	v_out.pos      = ProjectStagePoint(p, aspect, is_cube);
	v_out.uv       = v_in.uv;
	v_out.stage_uv = v_in.pos.xy;
	v_out.turn     = turn;
	v_out.peak     = ComputePeak(rot_rad, pos_offset);
	v_out.is_cube  = is_cube;
	return v_out;
}

// ---------------- REUSABLE STAGE RENDERERS ----------------
float4 RenderCeiling(FragData f_in, float3 primary, float3 accent, float3 spot_col)
{
	if (f_in.is_cube < 0.5 || f_in.turn < 0.002)
		discard;

	float u = f_in.stage_uv.x;
	float v = f_in.stage_uv.y;

	float2 t_uv  = float2(u * 10.0, v * 5.0);
	float  truss = smoothstep(0.09, 0.03, min(abs(frac(t_uv.x + t_uv.y) - 0.5), abs(frac(t_uv.x - t_uv.y) - 0.5)));
	float  pods  = exp(-(pow(abs(frac(u * 3.0) - 0.5), 2.0) * 45.0 + pow(abs(v - 0.48), 2.0) * 35.0));
	float  pulse = 0.5 + 0.5 * sin(u * 18.0 - rot_rad.y * 12.0 + time_sec * 4.0);
	float  rim   = smoothstep(0.06, 0.0, v) + smoothstep(0.05, 0.0, 1.0 - v);

	float3 col = float3(0.02, 0.024, 0.035) + float3(0.06, 0.07, 0.10) * truss;
	col += spot_col * pods * (0.85 + 0.35 * f_in.peak);
	col += lerp(primary, accent, pulse) * rim * 0.85;

	float edge_fade = smoothstep(0.0, 0.04, v) * smoothstep(0.0, 0.02, min(u, 1.0 - u));
	float out_a     = saturate((0.72 * v + pods * 0.8 + rim * 0.85) * edge_fade) * f_in.turn * alpha;
	return float4(col * shade, out_a);
}

float4 RenderFloor(FragData f_in, float3 primary, float3 accent, float refl_str, float grid_str)
{
	if (f_in.is_cube < 0.5 || f_in.turn < 0.002)
		discard;

	float u = f_in.stage_uv.x;
	float v = f_in.stage_uv.y;

	float4 refl      = image.Sample(tex_sampler, f_in.uv);
	float  refl_fade = pow(saturate(v), 1.9) * refl_str;

	float2 grid_uv = float2(u * 14.0, v * 7.0 - abs(rot_rad.y) * 2.5);
	float2 fw      = max(fwidth(grid_uv), float2(0.001, 0.001));
	float2 grid_d  = abs(frac(grid_uv - 0.5) - 0.5) / fw;
	float  grid    = 1.0 - min(min(grid_d.x, grid_d.y), 1.0);

	float sweep_x = frac(abs(rot_rad.y) * 0.9 + 0.15);
	float laser   = exp(-pow((u - sweep_x) * 10.0, 2.0)) * f_in.peak;
	float eq_bars = step(0.4, frac(v * 14.0)) * smoothstep(0.07, 0.0, min(u, 1.0 - u));
	float front_r = smoothstep(0.055, 0.0, v);
	float wall_r  = smoothstep(0.045, 0.0, 1.0 - v);

	float3 col = float3(0.018, 0.022, 0.032) + refl.rgb * refl_fade;
	col += primary * (grid * grid_str * saturate(v + 0.2));
	col += primary * (front_r + wall_r) * 0.95;
	col += accent  * (eq_bars * 0.9 + laser * 0.65);

	float edge_fade = smoothstep(0.0, 0.04, v) * smoothstep(0.0, 0.02, min(u, 1.0 - u));
	float out_a     = saturate((0.78 * v + front_r + eq_bars * 0.8) * edge_fade) * f_in.turn * alpha;
	return float4(col * shade, out_a);
}

float4 RenderWallThemed(FragData f_in, float3 primary, float3 accent,
                        float chroma, float glitch_str, float scan_str, float bezel_w)
{
	float turn  = f_in.turn;
	float peak  = f_in.peak;
	float inset = bezel_w * turn;

	float2 framed_uv = (f_in.uv - 0.5) / max(1.0 - 2.0 * inset, 0.001) + 0.5;
	float2 edge_dist = min(framed_uv, 1.0 - framed_uv);
	float  inside    = step(0.0, edge_dist.x) * step(0.0, edge_dist.y);

	float band_id   = floor(framed_uv.y * 26.0);
	float time_step = floor((abs(rot_rad.y) + abs(rot_rad.x)) * 18.0);
	float band_rnd  = Hash11(band_id + time_step * 17.0);
	float glitch_on = step(0.82, band_rnd) * smoothstep(0.35, 0.95, peak);
	float2 g_uv     = framed_uv + float2((band_rnd - 0.5) * 2.0 * glitch_str * glitch_on, 0.0);

	float  rgb_off   = chroma * peak * turn;
	float4 base_col  = image.Sample(tex_sampler, saturate(g_uv));
	float  r_ch      = image.Sample(tex_sampler, saturate(g_uv + float2(rgb_off, 0.0))).r;
	float  b_ch      = image.Sample(tex_sampler, saturate(g_uv - float2(rgb_off, 0.0))).b;
	float3 scene_rgb = float3(r_ch, base_col.g, b_ch);

	float scanline   = 1.0 - (scan_str * turn * (0.5 + 0.5 * sin(framed_uv.y * 520.0)));
	float sweep_pos  = (rot_rad.y + rot_rad.x) * 0.75 + 0.5;
	float beam_d     = abs((f_in.uv.x * 0.75 + f_in.uv.y * 0.35) - sweep_pos);
	float spotlight  = exp(-beam_d * beam_d * 14.0) * 0.28 * turn;
	float seam_ao    = 1.0 - (0.30 * turn * smoothstep(0.14, 0.0, min(f_in.uv.x, 1.0 - f_in.uv.x)));

	float3 wall_rgb  = scene_rgb * scanline * shade * seam_ao + float3(0.96, 0.98, 1.0) * spotlight;

	float min_outer   = min(f_in.uv.x, min(1.0 - f_in.uv.x, min(f_in.uv.y, 1.0 - f_in.uv.y)));
	float inner_neon  = smoothstep(0.0055, 0.0, abs(min(edge_dist.x, edge_dist.y))) * turn;
	float perim_wave  = 0.5 + 0.5 * sin((f_in.uv.x + f_in.uv.y) * 14.0 - (rot_rad.y + rot_rad.x) * 10.0 + time_sec * 3.0);
	float3 neon_mix   = lerp(primary, accent, pow(perim_wave, 3.0));
	float corner_mask = step(0.38, min(abs(f_in.uv.x - 0.5), abs(f_in.uv.y - 0.5)));
	float bracket     = corner_mask * smoothstep(0.011, 0.0, min_outer) * turn;
	float ticks       = step(0.92, abs(sin(f_in.uv.x * 40.0))) * smoothstep(0.012, 0.0, min(f_in.uv.y, 1.0 - f_in.uv.y)) * turn;

	float3 bezel_rgb  = float3(0.032, 0.036, 0.050) + neon_mix * saturate(inner_neon * 1.25 + bracket * 1.35 + ticks * 0.5);

	float3 final_rgb  = lerp(bezel_rgb, wall_rgb, inside);
	float  final_a    = lerp(turn, base_col.a, inside) * alpha;
	return float4(final_rgb, final_a);
}

// ---------------- PIXEL SHADERS PER TECHNIQUE ----------------
float4 PS_Ceil_Cyber(FragData f) : TARGET { return RenderCeiling(f, float3(0.05, 0.85, 1.00), float3(1.00, 0.32, 0.12), float3(0.95, 0.97, 1.00)); }
float4 PS_Flr_Cyber (FragData f) : TARGET { return RenderFloor  (f, float3(0.05, 0.85, 1.00), float3(1.00, 0.32, 0.12), 0.42, 0.45); }
float4 PS_Wall_Cyber(FragData f) : TARGET { return RenderWallThemed(f, float3(0.05, 0.85, 1.00), float3(1.00, 0.32, 0.12), 0.0085, 0.012, 0.06, 0.022); }

float4 PS_Ceil_Gold(FragData f) : TARGET  { return RenderCeiling(f, float3(1.00, 0.78, 0.25), float3(1.00, 0.93, 0.70), float3(1.00, 0.94, 0.80)); }
float4 PS_Flr_Gold (FragData f) : TARGET  { return RenderFloor  (f, float3(1.00, 0.78, 0.25), float3(1.00, 0.93, 0.70), 0.48, 0.25); }
float4 PS_Wall_Gold(FragData f) : TARGET  { return RenderWallThemed(f, float3(1.00, 0.78, 0.25), float3(1.00, 0.93, 0.70), 0.0020, 0.000, 0.00, 0.020); }

float4 PS_Flr_Holo (FragData f) : TARGET  { return RenderFloor(f, float3(0.15, 0.95, 0.90), float3(0.75, 0.25, 1.00), 0.30, 0.75); }
float4 PS_Wall_Holo(FragData f) : TARGET
{
	float4 w = RenderWallThemed(f, float3(0.15, 0.95, 0.90), float3(0.75, 0.25, 1.00), 0.012, 0.016, 0.18, 0.016);
	float holo_sweep = exp(-pow((f.uv.y - frac(progress * 2.0)) * 9.0, 2.0)) * f.turn;
	w.rgb += float3(0.15, 0.95, 0.90) * holo_sweep * 0.45;
	w.a   *= lerp(1.0, 0.88, f.turn * 0.6);
	return w;
}

float4 PS_Wall_Clean(FragData f) : TARGET { return RenderWallThemed(f, float3(0.70, 0.80, 0.95), float3(1.00, 1.00, 1.00), 0.0000, 0.000, 0.00, 0.014); }

// ---------------- SELECTABLE TECHNIQUES ----------------
technique CyberArena
{
	pass Ceiling { vertex_shader = VS_Ceiling(v_in); pixel_shader = PS_Ceil_Cyber(f_in); }
	pass Floor   { vertex_shader = VS_Floor(v_in);   pixel_shader = PS_Flr_Cyber(f_in); }
	pass Wall    { vertex_shader = VS_Wall(v_in);    pixel_shader = PS_Wall_Cyber(f_in); }
}

technique ChampionshipGold
{
	pass Ceiling { vertex_shader = VS_Ceiling(v_in); pixel_shader = PS_Ceil_Gold(f_in); }
	pass Floor   { vertex_shader = VS_Floor(v_in);   pixel_shader = PS_Flr_Gold(f_in); }
	pass Wall    { vertex_shader = VS_Wall(v_in);    pixel_shader = PS_Wall_Gold(f_in); }
}

technique HoloMatrix
{
	pass Floor   { vertex_shader = VS_Floor(v_in);   pixel_shader = PS_Flr_Holo(f_in); }
	pass Wall    { vertex_shader = VS_Wall(v_in);    pixel_shader = PS_Wall_Holo(f_in); }
}

technique CleanBroadcast
{
	pass Wall    { vertex_shader = VS_Wall(v_in);    pixel_shader = PS_Wall_Clean(f_in); }
}
